# =========================================================
# ЗАВИСИМОСТИ
# =========================================================
node_modules/
backend/node_modules/
frontend/node_modules/

# Менеджеры пакетов
.pnpm-store/
.yarn/
.yarnrc.yml

# =========================================================
# СБОРКА И АРТЕФАКТЫ КОМПИЛЯЦИИ
# =========================================================
# Vite собирает в dist/
dist/
build/
frontend/dist/

# Скомпилированные TS-файлы (если остались от старой сборки)
frontend/src/**/*.js
frontend/src/**/*.js.map
!frontend/src/**/*.d.ts

# Кэш Vite
.vite/
frontend/.vite/
node_modules/.vite/

# Кэш TypeScript
*.tsbuildinfo
frontend/*.tsbuildinfo

# =========================================================
# БАЗА ДАННЫХ
# =========================================================
backend/db/*.sqlite
backend/db/*.sqlite3
backend/db/*.sqlite-journal
*.sqlite
*.sqlite3
*.db

# =========================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (СЕКРЕТЫ!)
# =========================================================
.env
.env.*
backend/.env
backend/.env.*
!.env.example

# =========================================================
# ЛОГИ
# =========================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================
# СИСТЕМНЫЕ ФАЙЛЫ И РЕДАКТОРЫ
# =========================================================
.DS_Store
Thumbs.db
desktop.ini

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# =========================================================
# ВРЕМЕННЫЕ ФАЙЛЫ
# =========================================================
.cache/
.temp/
.tmp/
*.bak

# =========================================================
# ТЕСТЫ И ПОКРЫТИЕ
# =========================================================
coverage/
.nyc_output/